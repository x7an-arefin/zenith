{
  "name": "zenith-cli",
  "version": "2.0.0",
  "description": "Multi-provider AI image & chat generation CLI — HuggingFace, Gitee AI, ModelScope, A4F",
  "type": "module",
  "bin": {
    "zenith": "./dist/cli.js",
    "zimg": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"console.log('\\n  ⚡ Zenith CLI installed!\\n     Run: zenith --help\\n     Or:  zimg --help\\n')\""
  },
  "dependencies": {
    "commander": "^13.1.0",
    "chalk": "^5.4.1",
    "ora": "^8.2.0",
    "open": "^10.1.2",
    "conf": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "ai",
    "image-generation",
    "cli",
    "huggingface",
    "gitee",
    "modelscope",
    "flux",
    "deepseek"
  ],
  "license": "MIT"
}
